{
  "name": "vitrina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static storefront skeleton for the Vitrina marketplace (demo data).",
  "scripts": {
    "build": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import,color-functions,global-builtin --no-source-map scss/main.scss assets/css/main.css",
    "watch": "sass --load-path=node_modules --quiet-deps --silence-deprecation=import,color-functions,global-builtin --no-source-map --watch scss/main.scss assets/css/main.css",
    "test": "node --test"
  },
  "devDependencies": {
    "bootstrap": "5.3.8",
    "sass": "1.105.1"
  }
}
